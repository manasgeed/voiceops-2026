# VoiceOps 2026 Environment Configuration Template
# Copy this file to .env and insert your personal API keys.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT.

# Gnani.ai Speech API (Required for Milestone 4 & 5)
GNANI_API_KEY=your_gnani_api_key_here

# LLM Provider API Key (e.g., Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
